# =====================================================================
# Variables del backend para el Centro de Pruebas QA.
# Copie este archivo como backend/.env (ignorado por git) y complete los
# valores. herramientas/levantar-backend-qa.ps1 lo lee al arrancar.
# NUNCA ponga contrasenas reales en este archivo de ejemplo.
# =====================================================================

# Backend y frontend que se prueban
QA_BASE_URL=http://localhost:8080
QA_FRONTEND_URL=http://localhost:4200

# Administrador de prueba (rol admin, activo) de la base phishshield_qa.
# La contrasena nunca se escribe en la evidencia, en los reportes ni en el log.
QA_TEST_USER=qa.admin@phishshield.bo
QA_TEST_PASSWORD=

# Nombre del ambiente que sale en los reportes
QA_AMBIENTE=phishshield_qa

# Carpeta de evidencias y reportes (por defecto backend/qa-evidencias, ignorada por git)
# QA_EVIDENCIAS_DIR=qa-evidencias

# Servicio de IA (por defecto http://localhost:8000)
# IA_URL=http://localhost:8000

# --- Opcional: envio de los reportes por correo (SMTP) ---
# Sin estas cuatro variables el envio se omite y la ejecucion queda con el
# correo en "no_configurado"; los reportes se descargan desde la pantalla.
# Con Gmail se usa una "contrasena de aplicacion", no la contrasena normal.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=            (opcional; por defecto MAIL_USERNAME)
# MAIL_STARTTLS=true

# --- Opcional: asistente de IA (Claude) ---
# Sin la clave, la pantalla oculta "Analizar con IA" y "Resumen con IA".
# El asistente nunca decide PASS ni FAIL.
# ANTHROPIC_API_KEY=
# QA_IA_MODELO=claude-opus-5-5
